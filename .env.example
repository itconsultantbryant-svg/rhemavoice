# Backend
DEBUG=1
SECRET_KEY=change-me-in-production
DATABASE_URL=postgres://rhema:rhema@localhost:5432/rhemavoice
DATABASE_SSL_REQUIRE=0
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:8000
OTP_DEBUG=1
OTP_CODE=123456
SECURE_SSL_REDIRECT=0

# Payments (sandbox by default; set PAYMENTS_MODE=live + secrets for production)
PAYMENTS_MODE=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
MOBILE_MONEY_API_KEY=
MOBILE_MONEY_WEBHOOK_SECRET=
USE_REDIS_CHANNELS=0

# Frontends (local)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_WS_URL=ws://localhost:8000

# --- Production (Render + Vercel) ---
# DEBUG=0
# SECRET_KEY=<long-random-string>
# DATABASE_URL=<Render Postgres connection string>
# DATABASE_SSL_REQUIRE=1
# ALLOWED_HOSTS=.onrender.com,your-api-domain.com
# CORS_ALLOWED_ORIGINS=https://your-web.vercel.app,https://your-admin.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-api.onrender.com,https://your-web.vercel.app,https://your-admin.vercel.app
# OTP_DEBUG=0
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com/api/v1
# NEXT_PUBLIC_WS_URL=wss://your-api.onrender.com
