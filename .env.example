# --- Neon Functions API (apps/neon-api) ---
# Neon injects DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED into the
# function runtime automatically. Set them locally for `neon dev` and for the
# Django migration/seed commands.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require
NEON_PROJECT_ID=
NEON_BRANCH=main
JWT_SECRET=change-me-to-a-long-random-string
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
OTP_DEBUG=1
OTP_CODE=123456
OTP_TTL_SECONDS=600
PAYMENTS_MODE=sandbox

# Payments (sandbox by default; set PAYMENTS_MODE=live + secrets for production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
MOBILE_MONEY_API_KEY=
MOBILE_MONEY_WEBHOOK_SECRET=

# --- Legacy Django backend (backend/) ---
DEBUG=1
SECRET_KEY=change-me-in-production
DATABASE_SSL_REQUIRE=0
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1,api
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:8000
USE_REDIS_CHANNELS=0
SECURE_SSL_REDIRECT=0

# --- Frontends (local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_WS_URL=ws://localhost:8000

# --- Production (Neon Functions + Vercel) ---
# CORS_ALLOWED_ORIGINS=https://your-web.vercel.app,https://your-admin.vercel.app
# OTP_DEBUG=0
# JWT_SECRET=<long-random-string>
# NEXT_PUBLIC_API_URL=https://<function>.compute.<region>.aws.neon.tech/api/v1
# NEXT_PUBLIC_WS_URL=wss://<function>.compute.<region>.aws.neon.tech
# EXPO_PUBLIC_API_URL=https://<function>.compute.<region>.aws.neon.tech/api/v1
# EXPO_PUBLIC_WS_URL=wss://<function>.compute.<region>.aws.neon.tech
